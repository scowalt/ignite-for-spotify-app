<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ignite.Infrastructure\Ignite.Infrastructure.fsproj" />
    <ProjectReference Include="..\..\src\Ignite.Core\Ignite.Core.fsproj" />
    <ProjectReference Include="../../src/Ignite.Migrations/Ignite.Migrations.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fixtures/legacy-schema-v1.sql" LogicalName="Ignite.Tests.LegacySchema.sql" />
    <EmbeddedResource Include="Fixtures/legacy-rows-v1.sql" LogicalName="Ignite.Tests.LegacyRows.sql" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="LegacySchema.fs" />
    <Compile Include="DatabaseTests.fs" />
    <Compile Include="DatabaseMigrationTests.fs" />
    <Compile Include="MigrationDeliveryTests.fs" />
    <Compile Include="MigrationCatalogueTests.fs" />
    <Compile Include="DatabaseStartupTests.fs" />
    <Compile Include="StoppedDatabaseInspectionTests.fs" />
    <Compile Include="MigrationCommandTests.fs" />
    <Compile Include="UserSessionRepositoryTests.fs" />
    <Compile Include="PlaylistSearchSnapshotRepositoryTests.fs" />
    <Compile Include="CdlcScraperTests.fs" />
    <Compile Include="SpotifyPlaylistPaginationTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
