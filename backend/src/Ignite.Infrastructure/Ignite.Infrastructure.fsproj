<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ignite.Core\Ignite.Core.fsproj" />
    <ProjectReference Include="..\Ignite.Matching\Ignite.Matching.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.2" />
    <PackageReference Include="dbup-core" Version="6.1.1" />
    <PackageReference Include="dbup-sqlite" Version="6.0.4" />
    <PackageReference Include="FSharp.Control.TaskSeq" Version="1.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.20" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="Polly" Version="8.8.0" />
    <PackageReference Include="Polly.RateLimiting" Version="8.8.0" />
    <PackageReference Include="SpotifyAPI.Web" Version="7.4.2" />
    <PackageReference Include="System.Threading.RateLimiting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/Migrations/*.sql" LogicalName="Ignite.Migrations.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Data/Migrations/manifest.json" LogicalName="Ignite.MigrationDelivery.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Config.fs" />
    <Compile Include="Data/DatabaseConfiguration.fs" />
    <Compile Include="Data/MigrationContracts.fs" />
    <Compile Include="Data/MigrationExpansion.fs" />
    <Compile Include="Data/DatabaseMigrations.fs" />
    <Compile Include="Data/MigrationCatalogue.fs" />
    <Compile Include="Data/ApplicationMigrations.fs" />
    <Compile Include="Data/IgniteDbContext.fs" />
    <Compile Include="Data/SongRepository.fs" />
    <Compile Include="Data/UserSessionRepository.fs" />
    <Compile Include="Data/PlaylistSearchSnapshotRepository.fs" />
    <Compile Include="Data/ScrapingJobRepository.fs" />
    <Compile Include="Spotify/SpotifyAuthService.fs" />
    <Compile Include="Spotify/RateLimitedSpotifyClient.fs" />
    <Compile Include="Scraping/CookiePersistence.fs" />
    <Compile Include="Scraping/CdlcScraper.fs" />
    <Compile Include="DependencyInjection.fs" />
  </ItemGroup>

</Project>
