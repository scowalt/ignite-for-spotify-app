{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabled": false,
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "dependencyDashboardAutoclose": true,
  "schedule": ["after 10pm every weekday", "before 5am every weekday", "every weekend"],
  "rebaseWhen": "conflicted",
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "rangeStrategy": "bump",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update source-built tools with their release commit",
      "managerFilePatterns": ["/^docker\\/Dockerfile\\.(?:backup|frontend)$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) packageName=(?<packageName>[^\\s]+)\\nARG [A-Z_]+_VERSION=(?<currentValue>v[^\\s]+)\\nARG [A-Z_]+_COMMIT=(?<currentDigest>[a-f0-9]{40})"
      ]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Group all non-major updates into one PR with auto-merge",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true
    },
    {
      "description": "Gate major updates behind dependency dashboard approval",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "Keep the Caddy runtime image and source release together",
      "matchPackageNames": ["caddy", "caddyserver/caddy"],
      "groupName": "caddy",
      "groupSlug": "caddy"
    },
    {
      "description": "Pin trivy-action away from tracking master branch",
      "matchPackageNames": ["aquasecurity/trivy-action"],
      "pinDigests": true
    },
    {
      "description": "Ignore docker-compose infra images managed by Watchtower",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["containrrr/watchtower", "grafana/alloy"],
      "enabled": false
    }
  ]
}
