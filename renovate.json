{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabled": true,
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "dependencyDashboardAutoclose": true,
  "schedule": ["after 10pm every weekday", "before 5am every weekday", "every weekend"],
  "rebaseWhen": "conflicted",
  "platformAutomerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "rangeStrategy": "bump",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Restic release and verified source commit together",
      "managerFilePatterns": ["/^docker\\/Dockerfile\\.backup$/"],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "restic/restic",
      "matchStrings": [
        "ARG RESTIC_VERSION=(?<currentValue>v[^\\s]+)\\nARG RESTIC_COMMIT=(?<currentDigest>[a-f0-9]{40})"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the Caddy release and verified source commit together",
      "managerFilePatterns": ["/^docker\\/Dockerfile\\.frontend$/"],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "caddyserver/caddy",
      "matchStrings": [
        "ARG CADDY_VERSION=(?<currentValue>v[^\\s]+)\\nARG CADDY_COMMIT=(?<currentDigest>[a-f0-9]{40})"
      ]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Keep infrastructure provider and module updates manually reviewed",
      "matchManagers": ["terraform"],
      "enabled": false
    },
    {
      "description": "Group all non-major updates into one PR with auto-merge",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true
    },
    {
      "description": "Gate major updates behind dependency dashboard approval",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "Keep the Caddy runtime image and source release together",
      "matchPackageNames": ["caddy", "caddyserver/caddy"],
      "groupName": "caddy",
      "groupSlug": "caddy"
    },
    {
      "description": "Pin trivy-action away from tracking master branch",
      "matchPackageNames": ["aquasecurity/trivy-action"],
      "pinDigests": true
    },
    {
      "description": "Keep retained Watchtower and shared Alloy changes manual",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["containrrr/watchtower", "grafana/alloy"],
      "enabled": false
    }
  ]
}
