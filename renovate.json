{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabled": true,
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "dependencyDashboard": { "enabled": true, "autoclose": true },
  "schedule": ["after 10pm every weekday", "before 5am every weekday", "every weekend"],
  "rebaseWhen": "conflicted",
  "platformAutomerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "rangeStrategy": "bump",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Restic release and verified source commit together",
      "managerFilePatterns": ["/^docker\\/Dockerfile\\.backup$/"],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "restic/restic",
      "matchStrings": [
        "ARG RESTIC_VERSION=(?<currentValue>v[^\\s]+)\\nARG RESTIC_COMMIT=(?<currentDigest>[a-f0-9]{40})"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the Caddy release and verified source commit together",
      "managerFilePatterns": ["/^docker\\/Dockerfile\\.frontend$/"],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "caddyserver/caddy",
      "matchStrings": [
        "ARG CADDY_VERSION=(?<currentValue>v[^\\s]+)\\nARG CADDY_COMMIT=(?<currentDigest>[a-f0-9]{40})"
      ]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Keep infrastructure provider and module updates manually reviewed",
      "matchManagers": ["terraform"],
      "enabled": false
    },
    {
      "description": "Group all non-major updates into one PR with auto-merge",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true
    },
    {
      "description": "Gate major updates behind dependency dashboard approval",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "Python minor releases change the interpreter series; keep them out of the automerged patch group",
      "matchPackageNames": ["python"],
      "matchUpdateTypes": ["minor"],
      "groupName": null,
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "The deployer refuses releases whose migration engine identity differs from the running release; hold the SDK and SQLite migration closure for a reviewed engine transition",
      "matchPackageNames": [
        "mcr.microsoft.com/dotnet/sdk",
        "dotnet-sdk",
        "dotnet",
        "FSharp.Core",
        "Microsoft.EntityFrameworkCore.Sqlite",
        "Microsoft.Data.Sqlite",
        "Microsoft.Data.Sqlite.Core",
        "/^SQLitePCLRaw\\./",
        "/^dbup/i",
        "/^Microsoft\\.Extensions\\./"
      ],
      "groupName": "migration engine",
      "groupSlug": "migration-engine",
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep the Caddy runtime image and source release together",
      "matchPackageNames": ["caddy", "caddyserver/caddy"],
      "groupName": "caddy",
      "groupSlug": "caddy"
    },
    {
      "description": "Pin trivy-action away from tracking master branch",
      "matchPackageNames": ["aquasecurity/trivy-action"],
      "pinDigests": true
    },
    {
      "description": "Keep retained Watchtower and shared Alloy changes manual",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["containrrr/watchtower", "grafana/alloy"],
      "enabled": false
    }
  ]
}
