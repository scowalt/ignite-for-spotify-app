FROM mcr.microsoft.com/dotnet/sdk:10.0.404 AS build
WORKDIR /src

COPY backend/src/Ignite.Core/Ignite.Core.fsproj Ignite.Core/
COPY backend/src/Ignite.Matching/Ignite.Matching.fsproj Ignite.Matching/
COPY backend/src/Ignite.Infrastructure/Ignite.Infrastructure.fsproj Ignite.Infrastructure/
COPY backend/src/Ignite.Jobs/Ignite.Jobs.fsproj Ignite.Jobs/
COPY backend/src/Ignite.Api/Ignite.Api.fsproj Ignite.Api/
COPY backend/src/Ignite.Migrations/Ignite.Migrations.fsproj Ignite.Migrations/
RUN dotnet restore Ignite.Api/Ignite.Api.fsproj \
    && dotnet restore Ignite.Migrations/Ignite.Migrations.fsproj

COPY backend/src/ .
RUN dotnet publish Ignite.Api/Ignite.Api.fsproj -c Release -o /app/publish --no-restore \
    && dotnet publish Ignite.Migrations/Ignite.Migrations.fsproj -c Release -o /app/publish/migrations --no-restore \
    && timeout 90s dotnet /app/publish/migrations/Ignite.Migrations.dll build-manifest > /app/publish/migration-catalogue.json

RUN apt-get update && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/collect-image-notices.py /tmp/collect-image-notices.py
RUN python3 /tmp/collect-image-notices.py dotnet \
    --deps /app/publish/Ignite.Api.deps.json \
    --deps /app/publish/migrations/Ignite.Migrations.deps.json \
    --packages /root/.nuget/packages --output /image-notices/dotnet

FROM mcr.microsoft.com/dotnet/sdk:10.0.404 AS test
WORKDIR /src
COPY backend/ .
RUN dotnet test Ignite.slnx --verbosity minimal

FROM mcr.microsoft.com/dotnet/aspnet:10.0.15 AS runtime
WORKDIR /app

RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r ignite && useradd -r -g ignite ignite

RUN mkdir -p /app/data && chown -R ignite:ignite /app/data

COPY --from=build /app/publish .
COPY --from=build /image-notices /usr/share/licenses/ignite/components
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/licenses/ignite/
COPY third-party/ /usr/share/licenses/ignite/source-inventory/

ENV ASPNETCORE_URLS=http://+:5050
ENV ASPNETCORE_ENVIRONMENT=Production

USER ignite

EXPOSE 5050

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5050/health/ready || exit 1

ENTRYPOINT ["dotnet", "Ignite.Api.dll"]
